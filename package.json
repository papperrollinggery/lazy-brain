{
  "name": "lazybrain",
  "version": "2.0.1",
  "description": "Deterministic capability router and orchestration engine for local AI agents",
  "type": "module",
  "bin": {
    "lazybrain": "dist/bin/lazybrain.js",
    "lb": "dist/bin/lazybrain.js",
    "lazybrain-mcp": "dist/bin/mcp.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs/assets",
    "docs/INSTALL.md",
    "docs/PRIVACY.md",
    "docs/RELEASE_CHECKLIST.md",
    "docs/USE_CASES.md",
    "README_CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "audit:public": "node scripts/audit-public.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "cli",
    "mcp",
    "deterministic",
    "skill-orchestration",
    "agent-orchestration",
    "ai-agent",
    "knowledge-graph",
    "lazybrain"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papperrollinggery/lazy-brain.git"
  },
  "homepage": "https://github.com/papperrollinggery/lazy-brain#readme",
  "bugs": {
    "url": "https://github.com/papperrollinggery/lazy-brain/issues"
  }
}
